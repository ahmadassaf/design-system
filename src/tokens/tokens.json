{
  "dsVariables": {
    "dark": {
      "--ds-color-border": "#303030",
      "--ds-color-surface": "#171717",
      "--ds-color-surface-muted": "#262626",
      "--ds-color-text": "#f5f5f5",
      "--ds-color-text-muted": "#d4d4d4",
      "--ds-color-text-subtle": "#a3a3a3"
    },
    "root": {
      "--ds-color-accent": "#2563eb",
      "--ds-color-accent-dark": "#1d4ed8",
      "--ds-color-accent-foreground": "#ffffff",
      "--ds-color-accent-muted": "#dbeafe",
      "--ds-color-accent-subtle": "#eff6ff",
      "--ds-color-border": "#d4d4d4",
      "--ds-color-border-dark": "#303030",
      "--ds-color-border-muted": "#f5f5f5",
      "--ds-color-dark": "#171717",
      "--ds-color-surface": "#ffffff",
      "--ds-color-surface-dark": "#171717",
      "--ds-color-surface-muted": "#fafafa",
      "--ds-color-surface-raised": "#ffffff",
      "--ds-color-text": "#171717",
      "--ds-color-text-inverse": "#ffffff",
      "--ds-color-text-muted": "#404040",
      "--ds-color-text-subtle": "#737373"
    }
  },
  "paletteNames": [ "blue", "gray", "green", "indigo", "neutral", "red", "yellow" ],
  "paletteShades": [ "50", "100", "200", "300", "500", "600", "700", "900" ],
  "radii": {
    "card": "0.5rem",
    "control": "0.5rem",
    "pill": "0.125rem",
    "sm": "0.375rem"
  },
  "semanticColors": {
    "accent": {
      "DEFAULT": "var(--ds-color-accent)",
      "dark": "var(--ds-color-accent-dark)",
      "foreground": "var(--ds-color-accent-foreground)",
      "muted": "var(--ds-color-accent-muted)",
      "subtle": "var(--ds-color-accent-subtle)"
    },
    "background": "var(--ds-color-surface)",
    "border": {
      "DEFAULT": "var(--ds-color-border)",
      "dark": "var(--ds-color-border-dark)",
      "muted": "var(--ds-color-border-muted)"
    },
    "dark": "var(--ds-color-dark)",
    "foreground": "var(--ds-color-text)",
    "surface": {
      "DEFAULT": "var(--ds-color-surface)",
      "dark": "var(--ds-color-surface-dark)",
      "muted": "var(--ds-color-surface-muted)",
      "raised": "var(--ds-color-surface-raised)"
    },
    "text": {
      "DEFAULT": "var(--ds-color-text)",
      "inverse": "var(--ds-color-text-inverse)",
      "muted": "var(--ds-color-text-muted)",
      "subtle": "var(--ds-color-text-subtle)"
    }
  },
  "shadows": {
    "card": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
    "cardHover": "0 10px 20px -12px rgb(0 0 0 / 0.25)",
    "kbd": "0 2px 0 0 rgb(0 0 0 / 0.08)",
    "kbdDark": "0 2px 0 0 rgb(0 0 0 / 0.5)"
  },
  "typography": {
    "fontFamily": {
      "mono": [ "JetBrains Mono", "Menlo", "Monaco", "monospace" ],
      "sans": [ "var(--font-space-inter)", "Inter Variable", "system-ui", "sans-serif" ]
    },
    "lineHeight": {
      "body": "1.6",
      "prose": "1.7",
      "tight": "1.15"
    },
    "prose": {
      "fontSize": "1rem",
      "headingMargin": {
        "h1": {
          "bottom": "0.95em",
          "top": "1.25em"
        },
        "h2": {
          "bottom": "0.9em",
          "top": "1.2em"
        },
        "h3": {
          "bottom": "0.8em",
          "top": "1.1em"
        },
        "h4": {
          "bottom": "0.7em",
          "top": "1em"
        }
      },
      "maxWidth": "none"
    }
  }
}
